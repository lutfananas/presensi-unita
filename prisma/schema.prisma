generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Attendance {
  id          String   @id @default(cuid())
  namaLengkap String
  unitKerja   String
  type        String
  pesan       String?
  photoPath   String?
  photoData   String?
  createdAt   DateTime @default(now())
}

model WFHActivity {
  id                String   @id @default(cuid())
  namaLengkap       String
  unitKerja         String
  deskripsiPekerjaan String
  createdAt         DateTime @default(now())
}
