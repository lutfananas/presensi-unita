generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Attendance {
  id          String   @id @default(cuid())
  namaLengkap String
  unitKerja   String
  type        String   // "HADIR" or "PULANG"
  pesan       String?  // optional message
  photoPath   String?  // path to uploaded photo
  photoData   String?  // base64 photo data stored directly
  createdAt   DateTime @default(now())
}

model WFHActivity {
  id               String   @id @default(cuid())
  namaLengkap      String
  unitKerja        String
  deskripsiPekerjaan String
  createdAt        DateTime @default(now())
}
